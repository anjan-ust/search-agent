# SerpApi key - https://serpapi.com/manage-api-key (free tier: 250 searches/month)
SERPAPI_KEY=

# Groq API key - https://console.groq.com/keys (free tier)
GROQ_API_KEY=

# imgbb API key - https://api.imgbb.com/ (free tier, used only to get a
# temporary public URL for the uploaded dress photo)
IMGBB_API_KEY=

# Groq model ids - check https://console.groq.com/docs/models for current
# names, these change as Groq adds/retires models.
GROQ_VLM_MODEL=llama-3.2-11b-vision-preview
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# verify_availability tuning
VERIFY_TOP_N=12
VERIFY_MAX_CONCURRENCY=5
